        { text: "人々、絶えずとぶらひに〇。", target: "来", base: "来", row: "カ行", type: "カ行変格活用", form: "終止形", forms: ["こ", "き", "く", "くる", "くれ", "こ（よ）"] },
        { text: "しのびて〇〇人見知りてほゆる犬。", target: "来る", base: "来", row: "カ行", type: "カ行変格活用", form: "連体形", forms: ["こ", "き", "く", "くる", "くれ", "こ（よ）"] },
        { text: "春〇〇ば雁帰るなり", target: "来れ", base: "来", row: "カ行", type: "カ行変格活用", form: "已然形", forms: ["こ", "き", "く", "くる", "くれ", "こ（よ）"] },
        { text: "いみじからむ心地も〇ず。", target: "せ", base: "す", row: "サ行", type: "サ行変格活用", form: "未然形", forms: ["せ", "し", "す", "する", "すれ", "せよ"] },
        { text: "遺恨のわざをも〇たりけるかな。", target: "し", base: "す", row: "サ行", type: "サ行変格活用", form: "連用形", forms: ["せ", "し", "す", "する", "すれ", "せよ"] },
        { text: "戌の時に、門出〇。", target: "す", base: "す", row: "サ行", type: "サ行変格活用", form: "終止形", forms: ["せ", "し", "す", "する", "すれ", "せよ"] },
        { text: "もとより友と〇〇人", target: "する", base: "す", row: "サ行", type: "サ行変格活用", form: "連体形", forms: ["せ", "し", "す", "する", "すれ", "せよ"] },
        { text: "弓矢を取り立てむと〇〇ども", target: "すれ", base: "す", row: "サ行", type: "サ行変格活用", form: "已然形", forms: ["せ", "し", "す", "する", "すれ", "せよ"] },
        { text: "教経に組んで生け捕りに〇〇。", target: "せよ", base: "す", row: "サ行", type: "サ行変格活用", form: "命令形", forms: ["せ", "し", "す", "する", "すれ", "せよ"] },
        { text: "一杯食へども〇〇ず", target: "死な", base: "死ぬ", row: "ナ行", type: "ナ行変格活用", form: "未然形", forms: ["な", "に", "ぬ", "ぬる", "ぬれ", "ね"] },
        { text: "〇〇てののちまでも", target: "死に", base: "死ぬ", row: "ナ行", type: "ナ行変格活用", form: "連用形", forms: ["な", "に", "ぬ", "ぬる", "ぬれ", "ね"] },
        { text: "炎にまぐれてたちまちに〇〇。", target: "死ぬ", base: "死ぬ", row: "ナ行", type: "ナ行変格活用", form: "終止形", forms: ["な", "に", "ぬ", "ぬる", "ぬれ", "ね"] },
        { text: "人の食ひつれば〇〇〇ものぞ。", target: "死ぬる", base: "死ぬ", row: "ナ行", type: "ナ行変格活用", form: "連体形", forms: ["な", "に", "ぬ", "ぬる", "ぬれ", "ね"] },
        { text: "つひにはその毒のゆゑに〇〇〇ども", target: "死ぬれ", base: "死ぬ", row: "ナ行", type: "ナ行変格活用", form: "已然形", forms: ["な", "に", "ぬ", "ぬる", "ぬれ", "ね"] },
        { text: "吾を〇〇とや思ほすらむ。", target: "死ね", base: "死ぬ", row: "ナ行", type: "ナ行変格活用", form: "命令形", forms: ["な", "に", "ぬ", "ぬる", "ぬれ", "ね"] },
        { text: "おのが身はこの国の人にも〇〇ず。", target: "あら", base: "あり", row: "ラ行", type: "ラ行変格活用", form: "未然形", forms: ["ら", "り", "り", "る", "れ", "れ"] },
        { text: "猫またといふもの〇〇て", target: "あり", base: "あり", row: "ラ行", type: "ラ行変格活用", form: "連用形", forms: ["ら", "り", "り", "る", "れ", "れ"] },
        { text: "いと大きなる河〇〇。", target: "あり", base: "あり", row: "ラ行", type: "ラ行変格活用", form: "終止形", forms: ["ら", "り", "り", "る", "れ", "れ"] },
        { text: "清水の〇〇所に伏しにけり。", target: "ある", base: "あり", row: "ラ行", type: "ラ行変格活用", form: "連体形", forms: ["ら", "り", "り", "る", "れ", "れ"] },
        { text: "銭〇〇ども用ゐざらむは", target: "あれ", base: "あり", row: "ラ行", type: "ラ行変格活用", form: "已然形", forms: ["ら", "り", "り", "る", "れ", "れ"] },
        { text: "なほここに〇〇。", target: "あれ", base: "あり", row: "ラ行", type: "ラ行変格活用", form: "命令形", forms: ["ら", "り", "り", "る", "れ", "れ"] },
        { text: "四十にたらぬほどにて〇〇んこそ、", target: "死な", base: "死ぬ", row: "ナ行", type: "ナ行変格活用", form: "未然形", forms: ["な", "に", "ぬ", "ぬる", "ぬれ", "ね"] },
        { text: "男女〇〇〇もの数十人、", target: "死ぬる", base: "死ぬ", row: "ナ行", type: "ナ行変格活用", form: "連体形", forms: ["な", "に", "ぬ", "ぬる", "ぬれ", "ね"] },
        { text: "水におぼれて、死なば〇〇。", target: "死ね", base: "死ぬ", row: "ナ行", type: "ナ行変格活用", form: "命令形", forms: ["な", "に", "ぬ", "ぬる", "ぬれ", "ね"] }
    ];

    const ALL_ROWS = ["ア行", "カ行", "ガ行", "サ行", "ザ行", "タ行", "ダ行", "ナ行", "ハ行", "バ行", "マ行", "ヤ行", "ラ行", "ワ行"];
    const ALL_TYPES = ["四段活用", "上一段活用", "上二段活用", "下一段活用", "下二段活用", "変格活用"];
    
    // 活用形のリスト（インデックス検索用）
    const ALL_FORMS = ["未然形", "連用形", "終止形", "連体形", "已然形", "命令形"];
    const FORM_INDEX_MAP = {
        "未然形": 0,
        "連用形": 1,
        "終止形": 2,
        "連体形": 3,
        "已然形": 4,
        "命令形": 5
    };

    const PRAISE_WORDS = ["お見事！", "素晴らしい！", "完璧！", "その調子！", "ナイス解答！", "エクセレント！"];

    const STAGE_ENEMIES = [
        { sprite: "👻", size: "4.5rem", filter: "drop-shadow(0 0 10px rgba(255, 255, 255, 0.6))" },
        { sprite: "🦇", size: "5.5rem", filter: "drop-shadow(0 0 15px rgba(180, 0, 255, 0.8))" },
        { sprite: "🧟", size: "6.5rem", filter: "drop-shadow(0 0 20px rgba(0, 255, 0, 0.8))" },
        { sprite: "👹", size: "7.5rem", filter: "drop-shadow(0 0 25px rgba(255, 0, 0, 0.9))" },
        { sprite: "🐉", size: "9rem", filter: "drop-shadow(0 0 35px rgba(255, 215, 0, 1))" }
    ];

    // --- Game State ---
    let selectedTypes = [];
    let questionPool = [];
    let currentStage = 1;
    let stageCorrectCount = 0; 
    let lives = 5;
    let maxLives = 7;
    let currentQuestionData = null;
    let timerId = null;
    let isAnswering = false;

    let lastQuestionBase = null;
    let lastQuestionType = null;
    let typeUsageCount = {};

    let selectedRow = null;
    let selectedType = null;
    let selectedForm = null;
    let currentSentenceHTML = "";

    // --- Initialization ---
    window.onload = () => {
        initCheckboxes();
    };

    function initCheckboxes() {
        const container = document.getElementById('type-checkboxes');
        ALL_TYPES.forEach(type => {
            const label = document.createElement('label');
            label.className = 'checkbox-label';
            label.innerHTML = `<input type="checkbox" value="${type}" checked> ${type}`;
            container.appendChild(label);
        });
    }

    function selectAllTypes(status) {
        const checkboxes = document.querySelectorAll('#type-checkboxes input');
        checkboxes.forEach(cb => cb.checked = status);
    }

    // --- Utilities ---
    function shuffleArray(array) {
        for (let i = array.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [array[i], array[j]] = [array[j], array[i]];
        }
        return array;
    }

    function getRandomItems(array, n, exclude) {
        const filtered = array.filter(item => item !== exclude);
        return shuffleArray(filtered).slice(0, n);
    }

    function switchScreen(screenId) {
        document.querySelectorAll('.screen').forEach(el => el.classList.remove('active'));
        document.getElementById(screenId).classList.add('active');
    }

    function updateLivesDisplay() {
        const hearts = '❤️'.repeat(lives) + '🖤'.repeat(maxLives - lives);
        document.getElementById('lives-display').innerText = hearts;
    }

    // --- Game Logic ---
    function startGame() {
        const checkboxes = document.querySelectorAll('#type-checkboxes input:checked');
        selectedTypes = Array.from(checkboxes).map(cb => cb.value);

        if (selectedTypes.length === 0) {
            alert("少なくとも1つの活用の種類を選択してください。");
            return;
        }

        questionPool = rawData.filter(q => {
            let typeCheck = q.type;
            if (q.type.includes("変格活用")) typeCheck = "変格活用";
            return selectedTypes.includes(typeCheck);
        });
        
        if (questionPool.length === 0) {
            alert("選択した種類の問題が見つかりません。");
            return;
        }

        lastQuestionBase = null;
        lastQuestionType = null;
        typeUsageCount = {};
        ALL_TYPES.forEach(t => typeUsageCount[t] = 0);

        currentStage = 1;
        lives = 5;
        startStage();
    }

    function startStage() {
        stageCorrectCount = 0;
        switchScreen('game-screen');
        setupQuestion();
    }

    function startNextStage() {
        currentStage++;
        if (lives < maxLives) lives++;
        startStage();
    }

    function getNextQuestion() {
        let valid = questionPool.filter(q => q.base !== lastQuestionBase);
        if (valid.length === 0) valid = questionPool;

        let activeTypes = [...new Set(valid.map(q => q.type.includes("変格活用") ? "変格活用" : q.type))];
        if (activeTypes.length > 1) {
            let validDiffType = valid.filter(q => {
                let t = q.type.includes("変格活用") ? "変格活用" : q.type;
                return t !== lastQuestionType;
            });
            if (validDiffType.length > 0) valid = validDiffType;
        }

        let minUsage = Infinity;
        valid.forEach(q => {
            let t = q.type.includes("変格活用") ? "変格活用" : q.type;
            if (typeUsageCount[t] < minUsage) minUsage = typeUsageCount[t];
        });

        let minUsageCandidates = valid.filter(q => {
            let t = q.type.includes("変格活用") ? "変格活用" : q.type;
            return typeUsageCount[t] === minUsage;
        });

        minUsageCandidates = shuffleArray(minUsageCandidates);
        let selected = minUsageCandidates[0];

        lastQuestionBase = selected.base;
        lastQuestionType = selected.type.includes("変格活用") ? "変格活用" : selected.type;
        typeUsageCount[lastQuestionType]++;

        return selected;
    }

    function setupQuestion() {
        isAnswering = false;
        selectedRow = null;
        selectedType = null;
        selectedForm = null;
        document.getElementById('result-overlay').style.display = 'none';
        
        const titleEl = document.getElementById('result-title');
        titleEl.classList.remove('active-pop');

        updateLivesDisplay();
        document.getElementById('stage-display').innerText = `STAGE: ${currentStage}/5`;
        document.getElementById('question-counter').innerText = `正解: ${stageCorrectCount}/7`;

        const enemyObj = STAGE_ENEMIES[currentStage - 1];
        const spriteEl = document.getElementById('enemy-sprite');
        spriteEl.innerText = enemyObj.sprite;
        spriteEl.style.fontSize = enemyObj.size;
        spriteEl.style.filter = enemyObj.filter;

        currentQuestionData = getNextQuestion();

        currentSentenceHTML = currentQuestionData.text.replace(/〇+/g, `<span class="target-verb">${currentQuestionData.target}</span>`);
        document.getElementById('enemy-sign').innerHTML = currentSentenceHTML;

        let correctTypeDisplay = currentQuestionData.type;
        if (correctTypeDisplay.includes("変格活用")) {
            correctTypeDisplay = "変格活用";
        }

        generateButtons('row-btns', ALL_ROWS, currentQuestionData.row, val => { selectedRow = val; checkAutomaticSubmit(); });
        generateButtons('type-btns', ALL_TYPES, correctTypeDisplay, val => { selectedType = val; checkAutomaticSubmit(); });
        generateButtons('form-btns', ALL_FORMS, currentQuestionData.form, val => { selectedForm = val; checkAutomaticSubmit(); });

        const timeLimit = getStageTime(currentStage);
        startTimer(timeLimit);
    }

    function generateButtons(containerId, allOptions, correctAnswer, onClickCb) {
        const container = document.getElementById(containerId);
        container.innerHTML = '';

        let options = getRandomItems(allOptions, 3, correctAnswer);
        options.push(correctAnswer);
        options = shuffleArray(options);

        options.forEach(opt => {
            const btn = document.createElement('button');
            btn.className = 'choice-btn';
            btn.innerText = opt;
            btn.onclick = () => {
                if(isAnswering) return;
                Array.from(container.children).forEach(c => c.classList.remove('selected'));
                btn.classList.add('selected');
                onClickCb(opt);
            };
            container.appendChild(btn);
        });
    }

    function checkAutomaticSubmit() {
        if (isAnswering) return;
        if (selectedRow && selectedType && selectedForm) {
            isAnswering = true; 
            setTimeout(checkAnswer, 200); 
        }
    }

    function getStageTime(stage) {
        if (stage <= 2) return 25000;
        if (stage <= 4) return 16000;
        return 12000;
    }

    function startTimer(duration) {
        const bar = document.getElementById('time-bar');
        const enemy = document.getElementById('enemy');
        
        bar.style.transition = 'none';
        bar.style.transform = 'scaleX(1)';
        
        enemy.style.animation = 'none';
        void enemy.offsetWidth;
        
        setTimeout(() => {
            bar.style.transition = `transform ${duration}ms linear`;
            bar.style.transform = 'scaleX(0)';
            enemy.style.animation = `approach ${duration}ms linear forwards`;
        }, 50);

        clearTimeout(timerId);
        timerId = setTimeout(() => {
            if(isAnswering) return;
            isAnswering = true;
            processAnswer(false, "時間切れ！");
        }, duration);
    }

    function stopTimer() {
        clearTimeout(timerId);
        const enemy = document.getElementById('enemy');
        const computedStyle = window.getComputedStyle(enemy);
        enemy.style.transform = computedStyle.getPropertyValue('transform');
        enemy.style.animation = 'none';
        
        const bar = document.getElementById('time-bar');
        const barStyle = window.getComputedStyle(bar);
        bar.style.transform = barStyle.getPropertyValue('transform');
        bar.style.transition = 'none';
    }

    function checkAnswer() {
        let correctTypeDisplay = currentQuestionData.type;
        if (correctTypeDisplay.includes("変格活用")) {
            correctTypeDisplay = "変格活用";
        }

        const isCorrect = (selectedRow === currentQuestionData.row && 
                           selectedType === correctTypeDisplay && 
                           selectedForm === currentQuestionData.form);
        
        let msg = "不正解！";
        if (isCorrect) {
            msg = PRAISE_WORDS[Math.floor(Math.random() * PRAISE_WORDS.length)];
        }
        processAnswer(isCorrect, msg);
    }

    function processAnswer(isCorrect, titleMsg) {
        stopTimer();

        if (isCorrect) {
            stageCorrectCount++;
        } else {
            lives--;
            updateLivesDisplay();
        }

        const overlay = document.getElementById('result-overlay');
        const title = document.getElementById('result-title');
        title.innerText = titleMsg;
        title.className = 'result-title ' + (isCorrect ? 'correct' : 'wrong');
        
        void title.offsetWidth; 
        title.classList.add('active-pop');

        document.getElementById('result-enemy-sign').innerHTML = currentSentenceHTML;
        document.getElementById('exp-base').innerText = currentQuestionData.base;
        document.getElementById('exp-details').innerText = `${currentQuestionData.row}・${currentQuestionData.type}・${currentQuestionData.form}`;

        // 正解の活用形のインデックスを常に取得するように変更
        let highlightIndex = FORM_INDEX_MAP[currentQuestionData.form];

        // 活用表の生成（該当箇所にハイライトを付与）
        let rowHTML = '';
        for (let i = 0; i < 6; i++) {
            if (i === highlightIndex) {
                rowHTML += `<td class="highlight-cell">${currentQuestionData.forms[i]}</td>`;
            } else {
                rowHTML += `<td>${currentQuestionData.forms[i]}</td>`;
            }
        }
        document.getElementById('katsuyou-row').innerHTML = rowHTML;

        overlay.style.display = 'flex';
    }

    function nextQuestion() {
        if (lives <= 0) {
            gameOver();
            return;
        }

        if (stageCorrectCount >= 7) {
            stageClear();
        } else {
            setupQuestion();
        }
    }

    function stageClear() {
        if (currentStage >= 5) {
            gameClear();
        } else {
            document.getElementById('sc-stage-text').innerText = `ステージ ${currentStage} 突破！`;
            switchScreen('stage-clear-screen');
        }
    }

    function gameOver() {
        saveRecord("GAME OVER");
        document.getElementById('go-stage-text').innerText = `到達: ステージ ${currentStage} (合計正解数: ${stageCorrectCount}/7)`;
        switchScreen('game-over-screen');
    }

    function gameClear() {
        saveRecord("CLEAR");
        document.getElementById('gc-score-text').innerText = `残りライフ: ${lives} / 7`;
        switchScreen('game-clear-screen');
    }

    function saveRecord(result) {
        let records = JSON.parse(localStorage.getItem('kanjiGoKotenRecords') || '[]');
        const date = new Date();
        const dateString = `${date.getFullYear()}/${(date.getMonth()+1).toString().padStart(2,'0')}/${date.getDate().toString().padStart(2,'0')} ${date.getHours().toString().padStart(2,'0')}:${date.getMinutes().toString().padStart(2,'0')}`;
        
        records.push({
            date: dateString,
            stage: currentStage,
            result: result
        });

        if(records.length > 10) records.shift();
        localStorage.setItem('kanjiGoKotenRecords', JSON.stringify(records));
    }

    function showRecords() {
        const tbody = document.getElementById('records-body');
        tbody.innerHTML = '';
        
        let records = JSON.parse(localStorage.getItem('kanjiGoKotenRecords') || '[]');
        if (records.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3">記録がありません</td></tr>';
        } else {
            records.reverse().forEach(r => {
                const tr = document.createElement('tr');
                tr.innerHTML = `<td>${r.date}</td><td>Stage ${r.stage}</td><td>${r.result}</td>`;
                tbody.appendChild(tr);
            });
        }

        switchScreen('records-screen');
    }

    function returnToTitle() {
        switchScreen('start-screen');
    }
</script>
