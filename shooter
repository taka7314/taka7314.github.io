        { text: "いと暗し。〇〇〇。", target: "上げよ", base: "上ぐ", row: "ガ行", type: "下二段活用", form: "命令形", forms: ["げ", "げ", "ぐ", "ぐる", "ぐれ", "げよ"] },
        { text: "人間の大事、この三つには〇〇ず。", target: "過ぎ", base: "過ぐ", row: "ガ行", type: "上二段活用", form: "未然形", forms: ["ぎ", "ぎ", "ぐ", "ぐる", "ぐれ", "ぎよ"] },
