        { text: "この一矢に定むべしと〇〇。", target: "思へ", base: "思ふ", row: "ハ行", type: "四段活用", form: "命令形", forms: ["は", "ひ", "ふ", "ふ", "へ", "へ"] },
        { text: "大きなる声を〇〇て泣き叫ぶ。", target: "上げ", base: "上ぐ", row: "ガ行", type: "下二段活用", form: "連用形", forms: ["げ", "げ", "ぐ", "ぐる", "ぐれ", "げよ"] },
        { text: "吹く風砂を〇〇。", target: "上ぐ", base: "上ぐ", row: "ガ行", type: "下二段活用", form: "終止形", forms: ["げ", "げ", "ぐ", "ぐる", "ぐれ", "げよ"] },
