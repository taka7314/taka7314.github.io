<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>古典文法 漢字GO風 動詞の活用アタック！</title>
    <style>
        :root {
            --primary: #00d2ff;
            --secondary: #3a7bd5;
            --bg-color: #121212;
            --panel-bg: rgba(30, 30, 30, 0.9);
            --text-main: #ffffff;
            --danger: #ff4b2b;
            --success: #00b09b;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Hiragino Kaku Gothic ProN', 'Meiryo', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        /* Screens */
        .screen {
            display: none;
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .screen.active {
            display: flex;
        }

        /* Title Screen */
        #start-screen {
            background: linear-gradient(135deg, #1f1c2c, #928dab);
            text-align: center;
        }

        h1 {
            font-size: 3rem;
            text-shadow: 0 0 10px var(--primary);
            margin-bottom: 10px;
        }
        
        .subtitle {
            font-size: 1.2rem;
            margin-bottom: 30px;
            color: #ddd;
        }

        .settings-panel {
            background: var(--panel-bg);
            padding: 20px;
            border-radius: 15px;
            border: 2px solid var(--primary);
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.3);
            width: 80%;
            max-width: 600px;
            text-align: left;
            margin-bottom: 20px;
            max-height: 40vh;
            overflow-y: auto;
        }

        .settings-panel h3 {
            margin-top: 0;
            border-bottom: 1px solid #555;
            padding-bottom: 10px;
        }

        .checkbox-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 10px;
        }

        .checkbox-label {
            display: flex;
            align-items: center;
            cursor: pointer;
            font-size: 1.1rem;
        }

        .checkbox-label input {
            margin-right: 8px;
            transform: scale(1.2);
        }

        .btn {
            padding: 15px 40px;
            font-size: 1.5rem;
            font-weight: bold;
            color: #fff;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            border: none;
            border-radius: 30px;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            margin: 10px;
        }

        .btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary);
        }

        .btn-secondary {
            background: #555;
            font-size: 1.2rem;
            padding: 10px 30px;
        }

        .btn-secondary:hover {
            background: #777;
            box-shadow: none;
        }

        /* Game Screen */
        #game-screen {
            background: radial-gradient(circle at center, #2a2a35 0%, #000000 100%);
            perspective: 800px;
        }

        .hud {
            position: absolute;
            top: 0;
            width: 100%;
            display: flex;
            justify-content: space-between;
            padding: 15px 30px;
            box-sizing: border-box;
            font-size: 1.5rem;
            font-weight: bold;
            z-index: 10;
            background: linear-gradient(to bottom, rgba(0,0,0,0.8), transparent);
        }

        .lives {
            color: #ff4b2b;
            letter-spacing: 5px;
        }

        .progress-container {
            position: absolute;
            top: 60px;
            width: 80%;
            height: 10px;
            background: #333;
            border-radius: 5px;
            overflow: hidden;
            z-index: 10;
        }

        .progress-bar {
            height: 100%;
            width: 100%;
            background: var(--primary);
            transform-origin: left;
        }

        /* 3D Game Area */
        .game-area {
            flex-grow: 1;
            width: 100%;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .enemy {
            position: absolute;
            display: flex;
            flex-direction: column;
            align-items: center;
            transform: translateZ(-500px) scale(0.6);
            opacity: 0;
        }

        @keyframes approach {
            0% {
                transform: translateZ(-500px) scale(0.6);
                opacity: 0;
            }
            10% {
                opacity: 1;
            }
            100% {
                transform: translateZ(200px) scale(1.2);
                opacity: 1;
            }
        }

        .enemy-sprite {
            margin-bottom: -20px;
            z-index: 2;
            transition: all 0.5s ease;
        }

        .enemy-sign {
            background: rgba(255, 255, 255, 0.95);
            color: #000;
            padding: 20px 30px;
            border-radius: 10px;
            border: 5px solid #8b4513;
            font-size: 2.5rem;
            font-weight: bold;
            text-align: center;
            box-shadow: 0 10px 20px rgba(0,0,0,0.5);
            max-width: 90vw;
            word-wrap: break-word;
        }

        .target-verb {
            color: #d32f2f;
            text-decoration: underline;
            font-size: 1.1em;
        }

        /* Control Panel */
        .controls {
            width: 100%;
            background: var(--panel-bg);
            padding: 15px;
            box-sizing: border-box;
            border-top: 2px solid var(--primary);
            display: flex;
            flex-direction: column;
            align-items: center;
            z-index: 10;
        }

        .choice-group {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            margin-bottom: 10px;
            width: 100%;
            max-width: 800px;
        }

        .choice-group-label {
            width: 100px;
            text-align: right;
            padding-right: 10px;
            font-weight: bold;
            line-height: 40px;
            color: var(--primary);
        }

        .choice-btns {
            display: flex;
            flex: 1;
            gap: 10px;
            justify-content: space-between;
        }

        .choice-btn {
            flex: 1;
            padding: 10px;
            background: #2a2a2a;
            border: 1px solid #555;
            color: #fff;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1rem;
            transition: all 0.2s;
        }

        .choice-btn:hover {
            background: #444;
        }

        .choice-btn.selected {
            background: var(--primary);
            color: #000;
            border-color: #fff;
            font-weight: bold;
            box-shadow: 0 0 10px var(--primary);
        }

        /* Result Overlay */
        #result-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 100;
        }

        @keyframes popUp {
            0% { transform: scale(0.5); opacity: 0; }
            70% { transform: scale(1.2); opacity: 1; }
            100% { transform: scale(1); opacity: 1; }
        }

        .result-title {
            font-size: 4rem;
            font-weight: bold;
            margin-bottom: 10px;
            opacity: 0;
        }

        .result-title.active-pop {
            animation: popUp 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        .correct { color: #00ff00; text-shadow: 0 0 30px #00ff00; }
        .wrong { color: #ff0000; text-shadow: 0 0 30px #ff0000; }

        .explanation-card {
            background: #f4f4f4;
            color: #000;
            padding: 20px 40px;
            border-radius: 10px;
            text-align: center;
            max-width: 95%;
            display: flex;
            flex-direction: column;
            align-items: center;
            box-shadow: 0 0 20px rgba(255,255,255,0.2);
        }

        .explanation-card h2 {
            margin-top: 0;
            color: #333;
            border-bottom: 2px solid #333;
            padding-bottom: 10px;
            width: 100%;
        }

        .explanation-content {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 40px;
            margin-top: 10px;
        }

        .katsuyou-table-container {
            display: flex;
            justify-content: center;
        }

        .katsuyou-table {
            writing-mode: vertical-rl;
            text-orientation: upright;
            border-collapse: collapse;
            font-family: 'Yu Mincho', 'MS Mincho', serif;
            font-size: 1.3rem;
            position: relative;
        }

        .katsuyou-table th, .katsuyou-table td {
            border: 2px solid #555;
            padding: 10px 15px;
            background: #fff;
            text-align: center;
            transition: all 0.3s ease;
        }

        .katsuyou-table th {
            background: #e0e0e0;
            font-weight: bold;
        }

        /* 正解時の活用形を光らせるクラス */
        .highlight-cell {
            background: linear-gradient(135deg, #fff9c4, #ffeb3b) !important;
            color: #d32f2f !important;
            font-weight: bold;
            border: 3px solid #fbc02d !important;
            box-shadow: inset 0 0 10px rgba(255, 193, 7, 0.5), 0 0 15px rgba(255, 215, 0, 0.8) !important;
            transform: scale(1.1);
            position: relative;
            z-index: 10;
            animation: pulse-glow 1s infinite alternate;
        }

        @keyframes pulse-glow {
            from { box-shadow: 0 0 10px rgba(255, 215, 0, 0.8); }
            to { box-shadow: 0 0 25px rgba(255, 160, 0, 1); }
        }

        .action-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #e9e9e9;
            padding: 20px;
            border-radius: 10px;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.1);
        }

        @media (max-width: 768px) {
            .explanation-content {
                flex-direction: column;
                gap: 15px;
            }
            .enemy-sign {
                font-size: 1.8rem;
            }
        }

        /* Screen specifics */
        .stats-box {
            background: var(--panel-bg);
            padding: 30px;
            border-radius: 15px;
            text-align: center;
            border: 2px solid var(--secondary);
            margin-bottom: 20px;
        }
        
        table.records-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        table.records-table th, table.records-table td {
            border: 1px solid #555;
            padding: 10px;
            text-align: center;
        }
        table.records-table th {
            background: var(--primary);
            color: #000;
        }
    </style>
</head>
<body>

    <div id="start-screen" class="screen active">
        <h1>古典文法<br>動詞の活用アタック！</h1>
        <div class="subtitle">迫り来る例文！活用の種類と形をすべて選んで撃破しろ！</div>
        
        <div class="settings-panel">
            <h3>出題する活用の種類を選択</h3>
            <div style="margin-bottom: 15px; display: flex; gap: 10px;">
                <button type="button" class="btn" style="padding: 5px 15px; font-size: 0.9rem; margin: 0; border-radius: 5px;" onclick="selectAllTypes(true)">すべて選択する</button>
                <button type="button" class="btn btn-secondary" style="padding: 5px 15px; font-size: 0.9rem; margin: 0; border-radius: 5px;" onclick="selectAllTypes(false)">すべて解除する</button>
            </div>
            <div class="checkbox-grid" id="type-checkboxes">
                </div>
        </div>

        <div>
            <button class="btn" onclick="startGame()">ゲームスタート</button>
        </div>
        <div>
            <button class="btn btn-secondary" onclick="showRecords()">成績を見る</button>
        </div>
    </div>

    <div id="game-screen" class="screen">
        <div class="hud">
            <div id="stage-display">STAGE: 1/5</div>
            <div id="question-counter">正解: 0/7</div>
            <div class="lives" id="lives-display">❤️❤️❤️❤️❤️</div>
        </div>
        <div class="progress-container">
            <div class="progress-bar" id="time-bar"></div>
        </div>

        <div class="game-area" id="game-area">
            <div class="enemy" id="enemy">
                <div class="enemy-sign" id="enemy-sign">
                    </div>
                <div class="enemy-sprite" id="enemy-sprite">👻</div>
            </div>
        </div>

        <div class="controls">
            <div class="choice-group">
                <div class="choice-group-label">活用の行</div>
                <div class="choice-btns" id="row-btns"></div>
            </div>
            <div class="choice-group">
                <div class="choice-group-label">活用の種類</div>
                <div class="choice-btns" id="type-btns"></div>
            </div>
            <div class="choice-group">
                <div class="choice-group-label">活用形</div>
                <div class="choice-btns" id="form-btns"></div>
            </div>
        </div>

        <div id="result-overlay">
            <div class="result-title" id="result-title"></div>
            <div class="enemy-sign" id="result-enemy-sign" style="margin-bottom: 20px; background: #fff; color: #000; font-size: 2rem;"></div>
            
            <div class="explanation-card">
                <h2>基本形：<span id="exp-base"></span></h2>
                <div class="explanation-content">
                    <div class="katsuyou-table-container">
                        <table class="katsuyou-table">
                            <thead>
                                <tr>
                                    <th>未然形</th>
                                    <th>連用形</th>
                                    <th>終止形</th>
                                    <th>連体形</th>
                                    <th>已然形</th>
                                    <th>命令形</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr id="katsuyou-row">
                                    </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="action-container">
                        <p style="font-weight:bold; color:#333; font-size: 1.2rem; margin: 0 0 15px 0; border-bottom: 2px dashed #999; padding-bottom: 10px;" id="exp-details"></p>
                        <button class="btn" style="padding: 12px 40px; font-size: 1.3rem; margin: 0;" onclick="nextQuestion()">次へ ➡</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="stage-clear-screen" class="screen">
        <h1 style="color: var(--success); font-size: 4rem;">STAGE CLEAR!</h1>
        <div class="stats-box">
            <h2 id="sc-stage-text">ステージ 1 突破！</h2>
            <p>ライフが1回復した！ (最大7)</p>
        </div>
        <button class="btn" onclick="startNextStage()">次のステージへ</button>
    </div>

    <div id="game-over-screen" class="screen">
        <h1 style="color: var(--danger); font-size: 4rem;">GAME OVER</h1>
        <div class="stats-box">
            <h2 id="go-stage-text"></h2>
            <p>ライフが尽きてしまった...</p>
        </div>
        <button class="btn" onclick="returnToTitle()">タイトルへ戻る</button>
    </div>

    <div id="game-clear-screen" class="screen">
        <h1 style="color: gold; font-size: 4rem; text-shadow: 0 0 20px gold;">GAME CLEAR!!</h1>
        <div class="stats-box">
            <h2>全ステージクリア！おめでとう！</h2>
            <p id="gc-score-text"></p>
        </div>
        <button class="btn" onclick="returnToTitle()">タイトルへ戻る</button>
    </div>

    <div id="records-screen" class="screen">
        <h1>過去の成績</h1>
        <div class="settings-panel" style="max-height: 60vh;">
            <table class="records-table" id="records-table">
                <thead>
                    <tr>
                        <th>日時</th>
                        <th>到達ステージ</th>
                        <th>結果</th>
                    </tr>
                </thead>
                <tbody id="records-body">
                    </tbody>
            </table>
        </div>
        <button class="btn btn-secondary" onclick="returnToTitle()">戻る</button>
    </div>

<script>
    // --- Data Base ---
    const rawData = [
        { text: "忘らるる身をば〇〇ず", target: "思は", base: "思ふ", row: "ハ行", type: "四段活用", form: "未然形", forms: ["は", "ひ", "ふ", "ふ", "へ", "へ"] },
        { text: "げにと〇〇て、人々忘れず。", target: "思ひ", base: "思ふ", row: "ハ行", type: "四段活用", form: "連用形", forms: ["は", "ひ", "ふ", "ふ", "へ", "へ"] },
        { text: "男はこの女をこそ得めと〇〇。", target: "思ふ", base: "思ふ", row: "ハ行", type: "四段活用", form: "終止形", forms: ["は", "ひ", "ふ", "ふ", "へ", "へ"] },
